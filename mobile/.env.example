# Copy this file to `.env` and fill in the values (`.env` is git-ignored).
# Restart Metro with `npx expo start -c` after changing any of these.

# Backend base URL including /api. On a physical device use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8000/api

# OAuth "Web application" client ID from Google Cloud (same value as the server's GOOGLE_CLIENT_ID).
# An Android OAuth client (package com.sportgo.mobile + your SHA-1) must also exist in the same project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# MapLibre style URL (vector style JSON), e.g. an OpenFreeMap or other provider style.
EXPO_PUBLIC_MAP_STYLE_URL=<map-style-url>
