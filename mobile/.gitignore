# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (machine-specific LAN IP for EXPO_PUBLIC_API_URL, not portable)
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# signing keys and cloud credentials (never commit these; EAS keeps the release keystore for you)
*.keystore
*.pfx
google-services.json
GoogleService-Info.plist
credentials.json
*service-account*.json
*-firebase-adminsdk-*.json
