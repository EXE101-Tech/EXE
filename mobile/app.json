{
  "expo": {
    "name": "SportGo",
    "slug": "sportgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sportgo-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sportgo.mobile"
    },
    "android": {
      "package": "com.sportgo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#080b14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080b14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép SportGo truy cập vị trí để tìm sân gần bạn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép SportGo truy cập ảnh để cập nhật ảnh đại diện/bìa.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-google-signin/google-signin",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41cf65ed-f332-431f-8d7c-223a643f5d74"
      }
    },
    "owner": "sportgo",
    "updates": {
      "url": "https://u.expo.dev/41cf65ed-f332-431f-8d7c-223a643f5d74"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
